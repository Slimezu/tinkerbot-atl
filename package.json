{
  "name": "tinkerbot-atl-ai",
  "private": true,
  "version": "1.0.0",
  "homepage": "https://RockingRidz.github.io/TinkerBot-Atal",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild ./server.ts --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "deploy": "gh-pages -d dist"
  },
  "dependencies": {
    "@daily-co/daily-js": "^0.92.2",
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vapi-ai/web": "^2.7.1",
    "@vitejs/plugin-react": "^5.0.4",
    "@wllama/wllama": "^3.6.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "highlight.js": "^11.12.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
